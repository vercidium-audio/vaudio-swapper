<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Configurations>Debug;Release</Configurations>

		<Version>1.9.0</Version>
		<AssemblyVersion>1.9.0</AssemblyVersion>
		<FileVersion>1.9.0</FileVersion>
		<InformationalVersion>1.9.0</InformationalVersion>
	</PropertyGroup>

	<!-- Set UseLocalVaudioSource=true (e.g. dotnet build -p:UseLocalVaudioSource=true, or a Directory.Build.props) to compile against the live ..\..\vaudio\dotnet\3d source instead of the prebuilt lib\vaudio.dll. -->
	<PropertyGroup>
		<UseLocalVaudioSource>false</UseLocalVaudioSource>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseLocalVaudioSource)' != 'true'">
		<Reference Include="vaudio">
			<HintPath>lib\vaudio.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalVaudioSource)' == 'true'">
		<ProjectReference Include="..\..\vaudio\dotnet\3d\vaudio3d.csproj" />
	</ItemGroup>

	<!-- Common C# code across 2D and 3D swapper -->
	<ItemGroup>
		<Compile Include="..\common\**\*.cs" LinkBase="common" />
	</ItemGroup>

	<!-- Omit lib/ from solution explorer -->
	<ItemGroup>
		<Compile Remove="lib\**" />
		<EmbeddedResource Remove="lib\**" />
		<None Remove="lib\**" />
	</ItemGroup>

	<!-- Sibling repository -->
	<ItemGroup>
		<ProjectReference Include="..\..\vaudio-native-wrapper-3d\vaudio-native-wrapper-3d.csproj" />
	</ItemGroup>
</Project>
