<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Configurations>Debug;Release</Configurations>

		<Version>1.10.0</Version>
		<AssemblyVersion>1.10.0</AssemblyVersion>
		<FileVersion>1.10.0</FileVersion>
		<InformationalVersion>1.10.0</InformationalVersion>
	</PropertyGroup>

	<PropertyGroup>
		<UseLocalVaudioSource>true</UseLocalVaudioSource>

		<!-- Separate output folders to prevent conflicts with parallel tests -->
		<IntermediateOutputPath>obj\$(Configuration)-local$(UseLocalVaudioSource)\</IntermediateOutputPath>
		<OutputPath>bin\$(Configuration)-local$(UseLocalVaudioSource)\</OutputPath>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseLocalVaudioSource)' != 'true'">
		<Reference Include="vaudio">
			<HintPath>lib\vaudio.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalVaudioSource)' == 'true'">
		<ProjectReference Include="..\..\vaudio\dotnet\3d\vaudio3d.csproj" />
	</ItemGroup>

	<!-- Common C# code for both 2D and 3D swappers -->
	<ItemGroup>
		<Compile Include="..\common\**\*.cs" LinkBase="common" />
	</ItemGroup>

	<!-- Hide lib/ in the solution explorer -->
	<ItemGroup>
		<Compile Remove="lib\**" />
		<EmbeddedResource Remove="lib\**" />
		<None Remove="lib\**" />
	</ItemGroup>

	<!-- Sibling repository -->
	<ItemGroup>
		<ProjectReference Include="..\..\vaudio-native-wrapper-3d\vaudio-native-wrapper-3d.csproj" />
	</ItemGroup>
</Project>
